# Smart City Traffic Management - Configuration Example
# Copy this file to .env and fill in with your actual values

# ============================================
# OpenAI / LLM Configuration
# ============================================

# Set to "true" to automatically execute plans generated by the LLM planner
EXECUTE_PLANS=true

# Enable LLM-based planning (set to "true" to enable)
LLM_PLANNER_ENABLED=true

# OpenAI API key (required if LLM_PLANNER_ENABLED=true)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use for planning
OPENAI_MODEL=gpt-4o-mini

# LLM temperature for plan generation

LLM_TEMPERATURE=0.3

# ============================================
# Environment IDs
# ============================================

PUMP_ID=Pump:001
WEATHER_STATION_ID=WeatherStation:001

# ============================================
# User Authentication
# ============================================

USER_TOKEN=user-token
HUMAN_APPROVAL_TOKEN=human-approval-token
CITIZEN_AUTO_APPROVE=true
IAM_DEFAULT_PERMISSIONS=pump:read,pump:control

# ============================================
# OPA (Open Policy Agent) Configuration
# ============================================

# Set to enable OPA-based policy evaluation
# Leave empty to use fallback policy engine
OPA_URL=
OPA_POLICY_PATH=v1/data/smartcity/allow
OPA_TIMEOUT_SECONDS=1.5

# ============================================
# API Server Configuration
# ============================================

MCP_SERVER_URL=http://localhost:8000/mcp
PUMP_MCP_SERVER_URL=http://localhost:8002/mcp
CONTEXT_BROKER_MCP_URL=http://localhost:8001/mcp
WEATHER_FORECAST_MCP_URL=http://localhost:8003/mcp
IAM_URL=http://localhost:8020
ORCHESTRATOR_URL=http://localhost:8030/orchestrate
CITIZEN_INTERFACE_URL=http://localhost:8040
IAM_TIMEOUT_SECONDS=3.0
MCP_TIMEOUT_SECONDS=4.0
CITIZEN_TIMEOUT_SECONDS=4.0

# ============================================
# Logging Configuration
# ============================================

LOG_LEVEL=INFO

# Structured JSON log file (per-stage events, trace-correlated)
JSON_LOG_FILE=logs/traces.jsonl

# ============================================
# Observability & Audit
# ============================================

# Tamper-evident audit log (hash-chained JSONL) of policy decisions and
# tool invocations. Queryable through monitor service endpoints:
#   GET  /audit/entries?trace_id=...&plan_id=...&component=...&event_type=...
#   GET  /audit/entries/{id}
#   GET  /audit/verify
# Prometheus metrics are exposed at /metrics on both monitor and MCP server.
AUDIT_LOG_FILE=logs/audit.jsonl
